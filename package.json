    "wechat",
    "wechat-bot",
    "wechat-bridge",
    "clawbot",
    "ilink",
    "extension",
    "ai-agent",
    "coding-agent"
  ],
  "license": "MIT",
  "files": [
    "src"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "echo \"No tests\""
  },
  "pi": {
    "extensions": [
      "./src/weixin.ts"
    ]
  },
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "*",
    "qrcode-terminal": "^0.12.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fyc09/pi-weixin-bridge.git"
  },
  "bug": {
    "url": "https://github.com/fyc09/pi-weixin-bridge/issues"
  },
  "homepage": "https://github.com/fyc09/pi-weixin-bridge#readme",
  "credit": "Inspired by huang-x-h/pi-weixinbot (MIT) — iLink protocol/login flow reference. This repo substantially rewrote the codebase; messaging, media, locking, monitor modules are original. Uses Tencent official ClawBot/iLink API."
